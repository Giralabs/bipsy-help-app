---
import type { Audience } from '../data/help';

interface Props { audience: Audience }
const { audience } = Astro.props;
---

<nav class="cats" aria-label="Temas de ayuda">
  {audience.categories.map((c) => (
    <a class="cat" href={`${audience.base}/${c.id}`}>
      <span class="cat__icon"><span class="material-symbols-rounded">{c.icon}</span></span>
      <span class="cat__name">{c.label}</span>
      <span class="cat__blurb">{c.blurb}</span>
      <span class="cat__count">
        {c.items.length} {c.items.length === 1 ? 'artículo' : 'artículos'}
        <span class="material-symbols-rounded" aria-hidden="true">arrow_forward</span>
      </span>
    </a>
  ))}
</nav>
